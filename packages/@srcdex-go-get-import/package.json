{
  "name": "@srcdex/go-get-import",
  "version": "0.1.0",
  "type": "module",
  "description": "Go vanity-import middleware for Fetch-API runtimes",
  "author": "Alejandro Mery <amery@apptly.co>",
  "license": "MIT",
  "homepage": "https://github.com/srcdex/website/tree/main/packages/@srcdex-go-get-import#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srcdex/website.git",
    "directory": "packages/@srcdex-go-get-import"
  },
  "bugs": {
    "url": "https://github.com/srcdex/website/issues"
  },
  "keywords": [
    "cloudflare",
    "go",
    "go-get",
    "go-import",
    "go-source",
    "golang",
    "handler",
    "http",
    "middleware",
    "typescript",
    "vanity-import",
    "worker"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "clean": "rimraf dist node_modules",
    "dev": "vitest",
    "dev:prepare": "obuild --stub",
    "lint": "eslint --fix .",
    "lint:_pkg-pr-new": "eslint --fix package.json",
    "lint:check": "eslint .",
    "precommit": "run-s dev:prepare lint type-check build test test:compat",
    "prepack": "run-s lint:_pkg-pr-new build lint:check type-check test publint",
    "prepare": "cross-test -s dist/index.mjs || obuild --stub",
    "publint": "publint",
    "publish:maybe": "npm view ${npm_package_name}@${npm_package_version} version 2>/dev/null && echo \"${npm_package_name}@${npm_package_version} already published\" || pnpm publish",
    "test": "vitest run",
    "test:compat": "node src/__tests__/compat.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "run-s type-check:main type-check:tools type-check:tests",
    "type-check:main": "tsc --noEmit -p tsconfig.json",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "type-check:tools": "tsc --noEmit -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@kagal/cross-test": "^0.1.3",
    "@poupe/eslint-config": "^0.10.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-istanbul": "^4.1.9",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "obuild": "^0.4.37",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">= 20.20.1",
    "pnpm": ">= 10.33.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
